# Option A: OpenAI (paid, needs billing set up)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...your-key-here...

# Option B: Google Gemini (free tier, no card required) -- get a key at
# https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
GEMINI_API_KEY=...your-key-here...
# Free-tier Gemini models can be tightly rate-limited (as low as 5 requests/
# minute). This forces at least this many seconds between every LLM call so
# we rarely hit 429s. Raise it if you still see rate-limit waits.
GEMINI_MIN_INTERVAL_SECONDS=13
